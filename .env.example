# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
#
# .env está en .gitignore: nunca se sube al repo.
# Si quieres trabajar contra el Supabase local (npx supabase start),
# usa un .env.local — tiene prioridad sobre .env.

# --- Supabase ---
# Panel de Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Panel de Supabase > Project Settings > API Keys > pestaña "Secret keys"
# Empieza por "sb_secret_". Es la clave que salta RLS: SOLO en servidor, nunca
# en navegador ni en el repo. (En proyectos antiguos se llamaba "service_role".)
SUPABASE_SECRET_KEY=

# Panel de Supabase > Project Settings > API Keys > "Publishable key"
# Empieza por "sb_publishable_". Se usará en fase 2, cuando mande el token
# del usuario. De momento no hace falta.
SUPABASE_PUBLISHABLE_KEY=

# --- Embeddings (búsqueda semántica) ---
# platform.openai.com > API keys. Modelo text-embedding-3-small, 1536 dims.
# Sin ella el servidor arranca igual y la búsqueda cae a texto.
OPENAI_API_KEY=

# --- Destilación (solo para el flujo de ingesta) ---
# console.anthropic.com > API keys. Convierte transcripciones en fichas.
# El servidor MCP funciona sin ella.
ANTHROPIC_API_KEY=

# --- Transcripción (InternalApps) ---
# Servicio propio: vídeo público -> texto. Repo: cristianalbertosanchez00-afk/InternalApps
# Los valores por defecto ya apuntan a producción; solo hace falta tocarlos
# para apuntar a local o cuando el endpoint acepte una clave.
# INTERNALAPPS_URL=
# INTERNALAPPS_ORIGEN=
INTERNALAPPS_API_KEY=

# --- Stripe ---
# dashboard.stripe.com > Desarrolladores > Claves API. Empieza por sk_.
# Sin ella todo funciona salvo transferir a los creadores: su parte se acumula.
STRIPE_SECRET_KEY=
# Firma de los webhooks. Empieza por whsec_.
STRIPE_WEBHOOK_SECRET=

# Los cuatro precios, creados a mano en el panel. No son secretos (aparecen en
# la URL de pago) pero cambiarlos cambia lo que se cobra.
# OJO: el IVA va al revés en cada plan, y es deliberado.
#   individual -> IVA INCLUIDO (es consumidor: el precio que ve es el que paga)
#   equipo     -> + IVA        (es empresa: se lo deduce)
STRIPE_PRECIO_INDIVIDUAL_MENSUAL=
STRIPE_PRECIO_INDIVIDUAL_ANUAL=
STRIPE_PRECIO_EQUIPO_MENSUAL=
STRIPE_PRECIO_EQUIPO_ANUAL=
# Mínimo de asientos del plan de equipo.
STRIPE_ASIENTOS_MINIMOS=3

# --- Notion (solo para el script de migración) ---
# notion.so/profile/integrations > New internal integration, y después
# compartir la base "Fichas de conocimiento" con ella.
NOTION_TOKEN=

# --- Servidor MCP ---
# Nº máximo de fichas que devuelve buscar_tecnica por defecto
CEREBRO_MAX_RESULTADOS=5

# Fase 1 sin auth: creadores que se sirven, por slug y separados por comas.
# Vacío = todos los creadores activos y con acuerdo firmado.
CEREBRO_CREADORES_POR_DEFECTO=

# --- Solo para el servidor HTTP (dist/http.js, el que corre en Railway) ---
# El transporte stdio no usa nada de esto.

# Puerto. En Railway lo inyecta la plataforma; en local, 8080 por defecto.
# PORT=8080

# Cerrojo: sin "si" el servidor HTTP no arranca. Existe porque todavía no hay
# autenticación y exponerlo en internet significa servir las fichas a cualquiera
# con la URL. Quítalo en cuanto entre el OAuth.
CEREBRO_PERMITIR_SIN_AUTH=

# Hosts admitidos en la cabecera Host, separados por comas. Vacío = sin
# comprobación. En Railway es redundante: su borde ya rechaza hosts que no
# conoce. Útil detrás de otro proxy.
CEREBRO_HOSTS_PERMITIDOS=

# Orígenes admitidos en la cabecera Origin, separados por comas. Vacío = sin
# comprobación. Sin auth da igual —el endpoint es público—, pero conviene
# tenerlo puesto para cuando entre el OAuth.
CEREBRO_ORIGENES_PERMITIDOS=

# client_id permitidos, separados por comas. VACÍO = se acepta cualquiera que
# venga del flujo OAuth de este proyecto de Supabase.
#
# Se deja vacío a propósito: con registro dinámico cada cliente MCP se registra
# solo y su client_id no se conoce de antemano, así que exigir lista blanca
# rompería las conexiones nuevas. Rellénalo el día que en este mismo proyecto de
# Supabase viva otra aplicación (la web), porque entonces SUS tokens también
# valdrían aquí.
CEREBRO_CLIENTES_PERMITIDOS=
