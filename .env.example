# --- Supabase ---
# Panel de Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave de servicio. SOLO servidor, nunca en cliente. Salta RLS.
# En fase 1 (sin auth) el servidor MCP lee con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Clave anónima. Se usará en fase 2, cuando el token del usuario mande.
SUPABASE_ANON_KEY=

# --- Servidor MCP ---
# Nº máximo de fichas que devuelve buscar_tecnica por defecto
CEREBRO_MAX_RESULTADOS=5

# Fase 1 sin auth: creador(es) que se sirven por defecto, separados por comas.
# Vacío = todos los creadores activos y con acuerdo firmado.
CEREBRO_CREADORES_POR_DEFECTO=
