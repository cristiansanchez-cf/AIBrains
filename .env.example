# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
#
# .env está en .gitignore: nunca se sube al repo.
# Si quieres trabajar contra el Supabase local (npx supabase start),
# usa un .env.local — tiene prioridad sobre .env.

# --- Supabase ---
# Panel de Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Panel de Supabase > Project Settings > API Keys > pestaña "Secret keys"
# Empieza por "sb_secret_". Es la clave que salta RLS: SOLO en servidor, nunca
# en navegador ni en el repo. (En proyectos antiguos se llamaba "service_role".)
SUPABASE_SECRET_KEY=

# Panel de Supabase > Project Settings > API Keys > "Publishable key"
# Empieza por "sb_publishable_". Se usará en fase 2, cuando mande el token
# del usuario. De momento no hace falta.
SUPABASE_PUBLISHABLE_KEY=

# --- Servidor MCP ---
# Nº máximo de fichas que devuelve buscar_tecnica por defecto
CEREBRO_MAX_RESULTADOS=5

# Fase 1 sin auth: creadores que se sirven, por slug y separados por comas.
# Vacío = todos los creadores activos y con acuerdo firmado.
CEREBRO_CREADORES_POR_DEFECTO=
