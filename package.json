{
  "name": "cerebro-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Servidor MCP del Cerebro de Ventas — conocimiento destilado con respuestas citadas",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cerebro-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && npm run build:navegador",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.navegador.json",
    "seed": "tsx scripts/seed.ts",
    "inspector": "npx -y @modelcontextprotocol/inspector tsx src/index.ts",
    "prueba": "tsx scripts/prueba-mcp.ts",
    "build:navegador": "esbuild src/navegador/consentimiento.ts --bundle --format=esm --minify --target=es2022 --outfile=dist/publico/consentimiento.js",
    "prueba:oauth": "tsx scripts/prueba-oauth.ts",
    "suscripciones": "tsx scripts/suscribir.ts",
    "migrar": "tsx scripts/migrar-notion.ts",
    "reindexar": "tsx scripts/reindexar.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.3",
    "jose": "^6.2.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "supabase": "^2.114.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
