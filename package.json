{
  "name": "cerebro-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Servidor MCP del Cerebro de Ventas — conocimiento destilado con respuestas citadas",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cerebro-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
